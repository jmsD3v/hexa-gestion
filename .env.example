# ============================================================
# HEXA GESTIÓN — Variables de Entorno
# Copiar a .env.local y completar con los valores reales
# NUNCA commitear .env.local al repositorio
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Obtén estos valores de https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Solo para operaciones admin en el servidor (nunca exponer al cliente)
# ⚠️ CRÍTICO: Mantén esta key en secreto. Nunca la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Para testing visual sin conectar a BD, habilita datos de prueba
# NEXT_PUBLIC_USE_MOCKS=true
# Acceso a páginas de demo:
# - http://localhost:3000/demo                (Dashboard con mocks)
# - http://localhost:3000/demo-responsive     (Testing responsive)
# - Menú lateral muestra "🎨 DEV" en desarrollo

# ── Alertas por email (Edge Function send-alertas) ────────────
# Obtén tu API key en https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email que recibirá el resumen diario de alertas
ALERT_EMAIL=admin@tuempresa.com
# Remitente (debe ser un dominio verificado en Resend)
FROM_EMAIL=alertas@tudominio.com
# URL pública de la app (para links en el email)
APP_URL=https://tu-app.vercel.app

# ── AFIP/ARCA (etapa posterior) ───────────────────────────────
# AFIP_CUIT=30717034186
# AFIP_CERT_PATH=/certs/prod.crt
# AFIP_KEY_PATH=/certs/prod.key
# AFIP_ENVIRONMENT=production
